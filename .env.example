SONGTSAM_THEME_GROUP_DASHBOARD_URL=https://test-gds.songtsam.com/product-journey/api/travelGroup/listTravelGroupDashboard

# 鉴权中心地址（开发环境走 Vite proxy，留空发相对路径）
# 生产部署时改为实际地址
VITE_AUTH_URL=

# 移动端扫码访问地址。本地验证时可填 Vite 输出的 Network 地址，例如 http://192.168.1.75:5173
VITE_MOBILE_BASE_URL=
PORT=3000
HOST=127.0.0.1
